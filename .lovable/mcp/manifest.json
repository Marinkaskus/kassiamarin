{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vboxsrizrjinbcamdmuk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "kassiamarin",
      "version": "0.1.0",
      "title": "kassiamarin"
    },
    "tools": [
      {
        "name": "list_artworks",
        "title": "List artworks",
        "description": "List artworks in the gallery, optionally filtered by category or availability.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "description": "Filter by category, e.g. 'painting'."
            },
            "available": {
              "type": "boolean",
              "description": "Only artworks available for sale."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Maximum number of artworks."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_artwork",
        "title": "Create artwork",
        "description": "Add a new artwork to the gallery. Requires admin privileges on the signed-in account.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Artwork title."
            },
            "year": {
              "type": "string",
              "description": "Year of creation."
            },
            "medium": {
              "type": "string",
              "description": "Medium, e.g. 'Oil on canvas'."
            },
            "size": {
              "type": "string",
              "description": "Dimensions, e.g. '100 x 80 cm'."
            },
            "category": {
              "type": "string",
              "description": "Category grouping."
            },
            "description": {
              "type": "string",
              "description": "Description text."
            },
            "price": {
              "type": "string",
              "description": "Price as displayed."
            },
            "available": {
              "type": "boolean",
              "description": "Whether the artwork is available for sale."
            },
            "image_src": {
              "type": "string",
              "description": "Public image URL."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_artwork",
        "title": "Update artwork",
        "description": "Update fields of an existing artwork. Requires admin privileges on the signed-in account.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "description": "Artwork id."
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "year": {
              "type": "string"
            },
            "medium": {
              "type": "string"
            },
            "size": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "price": {
              "type": "string"
            },
            "available": {
              "type": "boolean"
            },
            "image_src": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_projects",
        "title": "List projects",
        "description": "List portfolio projects with their year, location and description.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Maximum number of projects."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_contact_messages",
        "title": "List contact messages",
        "description": "List messages sent through the site's contact form. Requires admin privileges on the signed-in account.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "unread_only": {
              "type": "boolean",
              "description": "Only return unread messages."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Maximum number of messages."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
